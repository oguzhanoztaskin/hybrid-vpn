<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up by Android: the database holds device inventories and DNS history, and
    future releases will hold VPN credentials. Backups are an explicit, encrypted export (M6).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
