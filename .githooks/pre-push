#!/usr/bin/env bash
set -euo pipefail
remote_name=${1:-}
remote_url=${2:-}
if [[ "$remote_name" != publish && "$remote_url" != *oguzhanoztaskin/hybrid-vpn.git && "$remote_url" != *oguzhanoztaskin/hybrid-vpn ]]; then
    exit 0
fi
if [[ ${HYBRIDVPN_PUBLISH_RELEASE:-} != 1 ]]; then
    echo 'Public pushes are release-only. Obtain an explicit release request and follow docs/RELEASING.md.' >&2
    exit 1
fi
snapshot=$(git rev-parse --verify refs/heads/release/public 2>/dev/null) || {
    echo 'Prepare a public release snapshot first.' >&2
    exit 1
}
while read -r subject; do
    if [[ ! "$subject" =~ ^Release\ v[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
        echo 'Public snapshot history contains development commits; refusing push.' >&2
        exit 1
    fi
done < <(git log --format=%s "$snapshot")
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ ${HYBRIDVPN_PUBLISH_REPLACE_HISTORY:-} == 1 && "$local_ref" == '(delete)' && ( "$remote_ref" == refs/tags/* || "$remote_ref" == refs/heads/* ) && "$remote_ref" != refs/heads/main ]]; then
        continue
    fi
    if [[ "$local_ref" == refs/heads/release/public && "$local_oid" == "$snapshot" && "$remote_ref" == refs/heads/main ]]; then
        continue
    fi
    if [[ "$local_ref" == refs/tags/v* && "$remote_ref" == "$local_ref" && $(git cat-file -t "$local_oid") == tag && $(git rev-parse "$local_ref^{commit}") == "$snapshot" ]]; then
        continue
    fi
    echo "Rejected public ref: $local_ref -> $remote_ref. Only release/public:main and its annotated release tag may be published." >&2
    exit 1
done
